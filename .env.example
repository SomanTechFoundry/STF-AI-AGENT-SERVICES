# ============================================================
# STF AI Agent Services — Environment Variables Template
# Copy this file to .env.local for local development.
# NEVER commit .env.local or any file containing real secrets.
# ============================================================

# ---- Application ----
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=debug

# ---- Database (Required) ----
# Neon PostgreSQL — get connection strings from your Neon project dashboard
# The pooled URL is used by Prisma Client at runtime
# The direct URL is used by Prisma Migrate
DATABASE_URL="postgresql://username:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://username:password@host/dbname?sslmode=require"

# ---- AI Providers ----
# At least one is required for Phase 3+
# Start with Gemini — get key at https://aistudio.google.com/
AI_DEFAULT_PROVIDER=gemini
GEMINI_API_KEY=

# OpenAI — add later
OPENAI_API_KEY=

# Anthropic — add later
ANTHROPIC_API_KEY=

# ---- Twilio (Phase 5 — SMS/Voice) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ---- Google Calendar (Phase 4) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback

# ---- Resend (Phase 5 — Transactional Email) ----
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ---- Stripe (Future — Client Subscriptions) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Sentry (Phase 6 — Error Monitoring) ----
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ---- Security ----
# A strong random secret for signing internal API tokens
# Generate with: openssl rand -hex 32
API_SECRET_KEY=

# ---- Rate Limiting ----
RATE_LIMIT_AGENT_RPM=60
